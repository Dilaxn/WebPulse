{
  "name": "web-monitor-agent",
  "version": "1.0.0",
  "description": "Intelligent Web Monitoring Agent - Scrape, Watch, Alert",
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && PORT=3002 npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "setup": "npm install && cd client && npm install && cd .. && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "node-cron": "^3.0.3",
    "cheerio": "^1.0.0-rc.12",
    "axios": "^1.6.2",
    "puppeteer": "^21.5.2",
    "nodemailer": "^8.0.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.4",
    "morgan": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
