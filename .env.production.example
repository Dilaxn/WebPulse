# ============================================
# PRODUCTION (Namecheap) — rename to .env on the server
# or paste these values into cPanel > Node.js App > Environment Variables
# ============================================

PORT=5002
NODE_ENV=production

# MongoDB (same Atlas URI is fine)
MONGO_URI=YOUR_MONGODB_URI

# JWT — USE A DIFFERENT STRONG SECRET IN PRODUCTION
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_64_CHARS

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_SMTP_USER
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM=WebPulse <notifications@example.com>

# OpenAI (gpt-4o-mini — cost-effective and accurate)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY_HERE

# Puppeteer — must be true on shared hosting (no Chrome available)
USE_CHEERIO_ONLY=true

# Your actual domain (https, no trailing slash)
APP_URL=https://yourdomain.com
